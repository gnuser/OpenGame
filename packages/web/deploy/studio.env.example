# Store the real file outside the checkout, readable only by the service account.
OPENGAME_ACCESS_MODE=invite
OPENGAME_APP_ORIGIN=https://studio.xiajuan.app
OPENGAME_PREVIEW_ORIGIN=https://studio-games.xiajuan.app
OPENGAME_PORT=4190
OPENGAME_PREVIEW_PORT=4191
OPENGAME_WEB_ROOT=/srv/opengame/packages/web
OPENGAME_DATA_DIR=/var/lib/opengame
OPENGAME_DATABASE_URL=postgresql://opengame:CHANGE_ME@127.0.0.1:5432/opengame
OPENGAME_PREVIEW_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
OPENGAME_CODEX_BIN=/opt/opengame-tools/bin/codex
# Native Linux executable only, read by the sandbox for its own re-execution.
OPENGAME_CODEX_SANDBOX_EXECUTABLE=/opt/opengame-tools/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex
OPENGAME_JOB_TIMEOUT_MS=600000
# Existing member UUIDs allowed to review and publish public knowledge.
# Empty by default; ordinary members may contribute their own general lessons.
OPENGAME_KNOWLEDGE_REVIEWERS=
NODE_ENV=production
